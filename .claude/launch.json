{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "devdiary-ui",
      "runtimeExecutable": "node",
      "runtimeArgs": ["node_modules/vite/bin/vite.js", "--host", "--port", "5174", "--strictPort"],
      "port": 5174,
      "autoPort": false
    },
    {
      "name": "devdiary-core",
      "runtimeExecutable": "node",
      "runtimeArgs": ["node_modules/.bin/tsx", "src/index.ts"],
      "cwd": "core",
      "env": {
        "DEVDIARY_PORT": "4317"
      },
      "port": 4317,
      "autoPort": false
    }
  ]
}
